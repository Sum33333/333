# 暨南大学番禺校区教室监控 — 校内生产环境变量模板
# 复制为 campus.env 后修改

PUBLIC_BASE_URL=https://classroom.netc.jnu.edu.cn
NETC_PORTAL_URL=https://netc.jnu.edu.cn/

# 运维后台令牌（强随机）
CLASSROOM_ADMIN_TOKEN=请替换为强随机字符串
AGENT_TOKEN=请替换为Agent上报令牌

# 统一身份认证
CAS_ENABLED=1
CAS_BASE_URL=https://mynet.jnu.edu.cn/cas
CAS_SERVICE_NAME=https://classroom.netc.jnu.edu.cn

# 校内录播 / 集控（向教育技术部索取真实地址）
RECORDER_API_URL=http://10.0.0.0/recorder/api
CENTRAL_CONTROL_API_URL=http://10.0.0.0/central/api

# OpenAPI（可选）https://openapi.jnu.edu.cn
OPENAPI_ENABLED=0
OPENAPI_APP_KEY=

# 生产关闭演示
CLASSROOM_DEMO_MODE=0
DEMO_AGENT_PUSH=0

# 教室清单 CSV（可选，覆盖自动生成）
# CLASSROOM_CSV=/data/panyu_rooms.csv
